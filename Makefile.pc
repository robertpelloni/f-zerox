# Makefile for F-Zero X PC Port

CC = gcc
CFLAGS = -Wall -Wextra -g -Iinclude/pc -Iinclude -D_LANGUAGE_C
LDFLAGS = -lSDL2 -lGL

SRC_DIRS = src/pc/sdl2 src/pc
# Add a game logic file to test linking (Math Utils + Debug Text)
GAME_SRCS = src/game_2B20.c src/game_197D0.c

# PC Implementation of Ultra64 functions
PC_IMPL_SRCS = src/pc/ultra_impl.c

BUILD_DIR = build/pc

SRCS = $(foreach dir,$(SRC_DIRS),$(wildcard $(dir)/*.c)) $(GAME_SRCS) $(PC_IMPL_SRCS)

SRCS = $(foreach dir,$(SRC_DIRS),$(wildcard $(dir)/*.c)) $(GAME_SRCS)
OBJS = $(SRCS:%.c=$(BUILD_DIR)/%.o)

TARGET = $(BUILD_DIR)/fzerox_pc

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJS)
	@mkdir -p $(dir $@)
	$(CC) $(OBJS) -o $@ $(LDFLAGS)
	@echo "Build successful: $(TARGET)"

$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -rf $(BUILD_DIR)
